<Project>

  <PropertyGroup>
    <!-- the single version source for both packages; a release tag must equal v<VersionPrefix>[-suffix], the suffix passed as -p:VersionSuffix. -->
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- what every assembly and package of the repository says about itself. A project states its own title and description. -->
  <PropertyGroup>
    <Company>9562-7303 Québec inc.</Company>
    <Authors>$(Company)</Authors>
    <Product>RDCore</Product>
    <Copyright>Copyright © 2026 $(Company)</Copyright>
    <!-- the strings in a project's .resx are English; the .fr.resx beside it is the French satellite. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- the licence's text is LICENSE; the code that comes from HexIDE is MIT too, and NOTICE.md names it. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rubberduck-vba/RDCore.Forms</PackageProjectUrl>
    <RepositoryUrl>https://github.com/rubberduck-vba/RDCore.Forms</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>VBA;VB6;MSForms;UserForm;Avalonia;RDCore;Rubberduck</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- nuget.org wants a PNG or a JPEG for a package's icon, not an .ico: the ducky of logo.ico, at 256 x 256. -->
    <PackageIcon>ducky.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- every project, its tests included, builds with no warning: a warning is an error. A missing xmldoc (CS1591) and an advisory published against
       a package are warnings still, which a build reports without failing: the first marks a member the API reference has no text for, the second is news of the
       package, not of the code built. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/ducky.png" Pack="true" PackagePath="" Visible="false" />
    <!-- the licence's text and the notice in each package, beside PackageLicenseExpression. -->
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
